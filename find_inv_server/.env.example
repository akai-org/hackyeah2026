# Skopiuj do .env i dostosuj. Plik .env nie trafia do gita.
APP_NAME=find_inv_server
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Zasobnik wiedzy (osobna baza SQLModel)
ZASOBNIK_DATABASE_URL=sqlite:///./zasobnik.db
# Token do /api/admin/* (nagłówek X-Admin-Token). ZMIEŃ!
ADMIN_TOKEN=change-me
# Wgraj dane przykładowe przy pustej bazie
SEED_DEMO_DATA=true

# LLM (OpenRouter). Bez klucza matchmaking działa na regułach lokalnych.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
