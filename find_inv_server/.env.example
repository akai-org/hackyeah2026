# Skopiuj do .env i uzupełnij. Plik .env nie trafia do gita.
APP_NAME=find_inv_server
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM (OpenRouter). Bez klucza matchmaking działa na regułach lokalnych (tagi, ranking TF-IDF, czat).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

DATABASE_URL=sqlite+aiosqlite:///./findinv.db
CHROMA_PATH=./chroma_db

# Zasobnik wiedzy (osobna baza SQLModel)
ZASOBNIK_DATABASE_URL=sqlite:///./zasobnik.db
# Token do /api/zasobnik/admin/* (nagłówek X-Admin-Token). ZMIEŃ!
ADMIN_TOKEN=change-me
# Wgraj dane przykładowe Zasobnika przy pustej bazie
SEED_DEMO_DATA=true
